# Lighter TypeScript SDK - Environment Configuration
# Copy this file to .env and fill in your actual values.
# Never commit your real .env file.

# Network selection. Drives both the API/WS host and the signing chain_id.
#   mainnet   -> https://mainnet.zklighter.elliot.ai  (chain_id 304)
#   testnet   -> https://testnet.zklighter.elliot.ai  (chain_id 300)
#   robinhood         -> https://api.rh.lighter.xyz           (chain_id 466324)
#   robinhood-testnet -> https://api.rh-testnet.lighter.xyz  (chain_id 300)
# Defaults to mainnet when unset. Examples and SignerClient (when `url`/`network`
# are omitted) read this via resolveNetworkFromEnv().
LIGHTER_NETWORK=mainnet
# LIGHTER_NETWORK=testnet
# LIGHTER_NETWORK=robinhood
# LIGHTER_NETWORK=robinhood-testnet

# Optional: point the SDK at a proxy or a local deployment.
# BASE_URL and WS_URL apply ONLY when LIGHTER_NETWORK is unset (comment out the
# line above to use them). While LIGHTER_NETWORK is set it decides both hosts and
# a leftover BASE_URL is ignored, so the host and the signing chain_id can never
# disagree. CHAIN_ID overrides the signing chain_id in either case.
# BASE_URL=https://mainnet.zklighter.elliot.ai
# WS_URL=wss://mainnet.zklighter.elliot.ai/stream
# CHAIN_ID=304

# Optional: read-only WebSocket stream for restricted regions (Robinhood).
# When true, examples append ?readonly=true to the WS URL.
# WS_READONLY=true

# Required: your Lighter API private key (used to sign L2 transactions).
# This is the 80-hex-character (40-byte) LIGHTER API KEY, NOT your Ethereum
# wallet key -- a 64-hex wallet key here will be rejected at startup.
# Generate one via `npx tsx examples/system_setup.ts` if you don't have one yet.
API_PRIVATE_KEY=your_lighter_api_private_key_here

# Required: your Lighter account index and the API key index you're using on that account.
ACCOUNT_INDEX=0
API_KEY_INDEX=0

# Optional: your Ethereum wallet private key. Only needed for operations that
# require an L1 signature (e.g. transfers/withdrawals to a brand-new account,
# or onboarding/API-key registration). Most day-to-day trading does not need this.
ETH_PRIVATE_KEY=

# Optional: destination address for withdrawal examples.
L1_ADDRESS=

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# ── Cross-venue MM (run_mm.ts cross_mm + mm_cross_venue_dashboard) ─────────
# Core mainnet credentials (fallbacks: CORE_* names also accepted)
LIGHTER_MAINNET_ACCOUNT_INDEX=
LIGHTER_MAINNET_API_KEY_INDEX=
LIGHTER_MAINNET_API_PRIVATE_KEY=
# Robinhood venue uses the default ACCOUNT_INDEX / API_KEY_INDEX / API_PRIVATE_KEY
# (RH_* names also accepted as overrides)

# ── MM runner knobs (examples/run_mm.ts) ────────────────────────────────────
# Every knob below also has a CLI flag, which wins over the env var:
#   npx tsx examples/run_mm.ts grid --venue=robinhood --grid-levels=4
#   npm run mm:as | mm:perp | mm:grid | mm:arb | mm:cross | mm:help
# Full reference with launch commands: docs/STRATEGIES.md
#
# MM_STRATEGY=as_mm|perp_mm|grid|arb_mm|cross_mm   (default as_mm)
# MM_VENUE=mainnet|robinhood                 (single-venue strategies; default = LIGHTER_NETWORK)
# RUN_MINUTES=15  MARKET_ID=1  MM_ORDER_SIZE=50  MM_MAX_POSITION=100
# MM_SPREAD_BPS=10  MM_HALF_SPREAD=20  MM_GRID_LEVELS=4  MM_GRID_SPACING=25
# MM_CYCLE_MS=12000  MM_REQUOTE_THRESHOLD=10
#
# Leverage set on the venue at EVERY strategy startup. Example: 3 -> IMF 3333.
# Unset leaves the venue's setting alone; a failed update aborts the start
# rather than quoting with unknown margin. Validated against the venue's cap
# (BTC: core max 50x, Robinhood max 5x).
# MM_LEVERAGE=3
# Per-venue overrides for cross_mm (core / robinhood); fall back to MM_LEVERAGE:
# MM_LEVERAGE_A=10
# MM_LEVERAGE_B=5
#
# File logs (default OFF). 1 -> logs/mm-<strategy>-<timestamp>.log, or a path.
# MM_LOG_FILE=1
#
# Hot config file (default OFF). 1 -> auto-filled mm-config.json next to the
# runner, re-read EVERY cycle: edit + save to change config mid-run without a
# restart. Same keys as the dashboard config menu (press Space).
# MM_HOT_CONFIG=1
#
# Plain log output instead of the live dashboard (use when piping).
# MM_NO_DASHBOARD=1
#
# Avellaneda-Stoikov (MM_STRATEGY=as_mm) only. Read docs/STRATEGIES.md before
# raising MM_AS_GAMMA on a funded account -- it drives both the inventory skew
# and the spread.
# MM_AS_GAMMA=0.5                 risk aversion (higher = wider + more skew)
# MM_AS_KAPPA=1.5                 order-arrival intensity (higher = tighter)
# MM_AS_HORIZON_MS=300000         session length for the (T-t) term
# MM_AS_INFINITE_HORIZON=1        pin (T-t)=1 for continuous running
# MM_AS_SIGMA=                    pin volatility instead of estimating it
# MM_AS_MIN_HALF_SPREAD_BPS=1     floor on each side
# MM_AS_MAX_HALF_SPREAD_BPS=100   ceiling on each side

# ── Builder fee attribution (DEFAULT-ON for MM strategies) ─────────────────
# Every order placed by the MM runner (examples/run_mm.ts) is attributed to
# the SDK builder's integrator account (per venue) at maker 0.5 bps / taker
# 2 bps (perps AND spot), per the partner-attribution program:
# https://apidocs.rh.lighter.xyz/docs/partner-attribution
#
# Fee units are MILLIONTHS of trade size: 50 = 0.5 bps, 200 = 2 bps.
# System caps (systemConfig): Core perps max 1000 (10 bps), RH max 10000.
#
# The runner auto-submits the one-time APPROVE_INTEGRATOR at startup
# (INTEGRATOR_AUTO_APPROVE=1 default; idempotent re-approve). L2 signature
# only when the builder shares your L1 address; otherwise the one-time
# approve needs ETH_PRIVATE_KEY (used ONLY for that signature — all trading
# stays L2/API-key). The runner fails fast with instructions if the key is
# missing/mismatched rather than sending a doomed approval.
#
# Opt out or customize:
#   BUILDER_ATTRIBUTION=off       disable attribution entirely
#   INTEGRATOR_ACCOUNT_INDEX=0    same thing, alternative spelling
#   INTEGRATOR_ACCOUNT_INDEX=N    attribute to your own integrator account
#   INTEGRATOR_TAKER_FEE / INTEGRATOR_MAKER_FEE (millionths; the _BPS
#                                 variants accept bps and convert)
#   INTEGRATOR_AUTO_APPROVE=0     skip startup approval (already approved)
#   INTEGRATOR_EXPIRY_SECONDS=31536000
#
# The SDK also caps what it will sign: maker 200 (2 bps), taker 1000 (10 bps).
# Above a cap it throws before any order is signed rather than clamping.
# Full details, including how attribution is enforced: docs/ATTRIBUTION.md
INTEGRATOR_TAKER_FEE=200
INTEGRATOR_MAKER_FEE=50
INTEGRATOR_EXPIRY_SECONDS=31536000
INTEGRATOR_AUTO_APPROVE=1

# ── Referral integration (examples/referral_integration.ts) ────────────────
# REFERRAL_OP=status|create|update-code|use-code|kickback|points|referrals
# REFERRAL_CODE=            # custom code (update-code)
# REFERRAL_BIND_CODE=       # code to bind to this account (use-code)
# REFERRAL_KICKBACK=        # fee share for referees, 0..1 (kickback)
