# Lighter TypeScript SDK - Environment Configuration
# Copy this file to .env and fill in your actual values.
# Never commit your real .env file.

# Network selection. Drives both the API/WS host and the signing chain_id.
#   mainnet   -> https://mainnet.zklighter.elliot.ai  (chain_id 304)
#   testnet   -> https://testnet.zklighter.elliot.ai  (chain_id 300)
#   robinhood         -> https://api.rh.lighter.xyz           (chain_id 466324)
#   robinhood-testnet -> https://api.rh-testnet.lighter.xyz  (chain_id 300)
# Defaults to mainnet when unset. Examples and SignerClient (when `url`/`network`
# are omitted) read this via resolveNetworkFromEnv().
LIGHTER_NETWORK=mainnet
# LIGHTER_NETWORK=testnet
# LIGHTER_NETWORK=robinhood
# LIGHTER_NETWORK=robinhood-testnet

# Optional: override the API/WS host and/or signing chain_id for a custom or
# local deployment. When unset, the values for LIGHTER_NETWORK are used.
# BASE_URL=https://mainnet.zklighter.elliot.ai
# WS_URL=wss://mainnet.zklighter.elliot.ai/stream
# CHAIN_ID=304

# Optional: read-only WebSocket stream for restricted regions (Robinhood).
# When true, examples append ?readonly=true to the WS URL.
# WS_READONLY=true

# Required: your Lighter API private key (used to sign L2 transactions).
# Generate one via `npx tsx examples/system_setup.ts` if you don't have one yet.
API_PRIVATE_KEY=your_lighter_api_private_key_here

# Required: your Lighter account index and the API key index you're using on that account.
ACCOUNT_INDEX=0
API_KEY_INDEX=0

# Optional: your Ethereum wallet private key. Only needed for operations that
# require an L1 signature (e.g. transfers/withdrawals to a brand-new account,
# or onboarding/API-key registration). Most day-to-day trading does not need this.
ETH_PRIVATE_KEY=

# Optional: destination address for withdrawal examples.
L1_ADDRESS=

# Optional: log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
